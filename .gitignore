# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# OS
.DS_Store

# Data: fetched from public sources by `make data`. Never committed - it is large,
# it is not ours, and every fetcher is idempotent so a clone reproduces it exactly.
data/raw/
data/warehouse/
*.duckdb
*.duckdb.wal
*.parquet
*.csv
!data/**/*.example.csv

# Model artifacts: regenerated by `make run`. Committing them would put binaries in
# every diff and make the repo history unreadable.
artifacts/*.pt
artifacts/*.npz
artifacts/*_cache.json

# The training checkpoint stays out - it is 1.8 MB of optimiser state that `make all`
# reproduces exactly (seeded, deterministic).
artifacts/model.pt

# The TRACED model is committed, deliberately. The serving image copies it in rather than
# training during the build, so that the model that was evaluated is byte-for-byte the
# model that ships - and that is only true if the artifact is in the repository. At
# 1.8 MB it is small enough not to make the history unreadable, and manifest.json carries
# its sha256 so a corrupted copy fails the build rather than serving quietly wrong
# predictions.
!artifacts/model_traced.pt
services/java-service/target/

# torchvision nests the dataset as data/FashionMNIST/raw/, not data/raw/ - so the
# generic rule misses it and 82MB of idx files were staged.
data/FashionMNIST/
data/*/raw/
*.idx1-ubyte
*.idx3-ubyte
