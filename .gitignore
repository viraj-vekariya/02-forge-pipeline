# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# OS
.DS_Store

# Data: fetched from public sources by `make data`. Never committed - it is large,
# it is not ours, and every fetcher is idempotent so a clone reproduces it exactly.
data/raw/
data/warehouse/
*.duckdb
*.duckdb.wal
*.parquet
*.csv
!data/**/*.example.csv

# Model artifacts: regenerated by `make run`. Committing them would put binaries in
# every diff and make the repo history unreadable.
artifacts/*.pt
artifacts/*.npz
artifacts/*_cache.json

# Trained weights - reproduced by `make all` (seeded, deterministic)
artifacts/model.pt
artifacts/model_traced.pt
services/java-service/target/

# torchvision nests the dataset as data/FashionMNIST/raw/, not data/raw/ - so the
# generic rule misses it and 82MB of idx files were staged.
data/FashionMNIST/
data/*/raw/
*.idx1-ubyte
*.idx3-ubyte
